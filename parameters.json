    "nicName": {
      "value": "nic-vm-wus3-dev-01"
    },
    "vmName": {
      "value": "vm-w11-wus3-dev-01"
    },
    "computerName": {
      "value": "vm-w11-dev-01"
    },
    "osDiskName": {
      "value": "disk-os-wus3-dev-01"
